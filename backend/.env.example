# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/phishshield
# or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/phishshield

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# AI Provider — choose one: "gemini" | "openai" | "claude"
AI_PROVIDER=gemini

# Google Gemini (recommended: generous free tier, good for this use case)
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-flash-latest always points to Google's current Flash model, so it
# won't go stale when Google retires older pinned versions (e.g. 2.5, 3.x).
# Pin an exact version instead only if you need reproducible behavior.
GEMINI_MODEL=gemini-flash-latest

# OpenAI (optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (optional alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-latest

# IP Geolocation (ip-api.com is free, no key needed for non-commercial use, 45 req/min)
# Optional: ipgeolocation.io key for higher limits / HTTPS
IPGEO_API_KEY=

# Google Safe Browsing (optional, extra reputation signal)
SAFE_BROWSING_API_KEY=

# VirusTotal (optional, extra reputation signal — free tier: virustotal.com/gui/join-us)
VIRUSTOTAL_API_KEY=
